# Шаблон файла с доступами к облаку Селектел. Значения сюда не вписывать.
# Скопировать в secrets.env
# Значения — в одинарных кавычках.

# Keystone
export OS_AUTH_URL='https://cloud.api.selcloud.ru/identity/v3'
# Номер аккаунта Селектел
export OS_USER_DOMAIN_NAME=''
export OS_PROJECT_DOMAIN_NAME=''
# ID проекта
export OS_PROJECT_ID=''
# Имя и пароль сервисного пользователя
export OS_USERNAME=''
export OS_PASSWORD=''

# S3-ключ сервисного пользователя (IAM → Сервисные пользователи → пользователь → S3-ключи)
export AWS_ACCESS_KEY_ID=''
export AWS_SECRET_ACCESS_KEY=''

# Зеркало провайдеров Terraform (не секрет, нужно для terraform init)
export TF_CLI_CONFIG_FILE="$(git rev-parse --show-toplevel)/selectel-mirror.tfrc"

# Пароли пользователей управляемого PostgreSQL (слой 03-databases), JSON в одну строку.
# Нужен пароль для каждого пользователя из postgresql_users в 03-databases/locals.tf.
# Используются только при создании пользователя, у существующих Terraform пароль не меняет.
# Одинарную кавычку в пароле использовать нельзя; двойную кавычку и обратную косую черту экранировать: \" и \\
export TF_VAR_db_user_passwords='{"user1":"","user2":"","user3":""}'

# Нужны провайдеру selectel только при импорте уже существующих ресурсов (не секреты)
# Номер аккаунта Селектел
export OS_DOMAIN_NAME=''
# ID проекта
export INFRA_PROJECT_ID=''
# INFRA_REGION сюда не добавлять: значение зависит от слоя, а переменная из файла
# перекрывает заданную вручную при каждом source. Задаётся в терминале перед импортом:
#   export INFRA_REGION=ru-6   # кластер и реестр (02-k8s, 04-storage)
#   export INFRA_REGION=ru-1   # DNS (05-dns): в каталоге пула ru-6 адреса DNS нет
